<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.PhysicsProject" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:buttonStyle">@style/CustomButtonStyle</item>
        <item name="android:editTextStyle">@style/CustomEditTextStyle</item>
    </style>
    <style name="CustomButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_marginLeft">15dp</item>
        <item name="android:layout_marginRight">15dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:insetTop">3dp</item>
        <item name="android:insetBottom">3dp</item>
    </style>
    <style name="CustomSignOut" parent="Widget.MaterialComponents.Button.TextButton"/>

    <style name="CustomImageButton" parent="Widget.MaterialComponents.Button">
        <item name="android:stateListAnimator">@animator/button_state_animator</item>
        <item name="android:background">@drawable/ripple_background</item>
    </style>
    <style name="CustomEditTextStyle">
        <item name="android:textColor">@color/white</item>
        <item name="android:colorAccent">@color/white</item>
        <item name="editTextColor">@color/white</item>
    </style>
    <style name="CustomImgButtonStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:layout_marginTop">28dp</item>
    </style>
</resources>