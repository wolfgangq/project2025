<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    app:strokeColor="#E0E0E0"
    app:strokeWidth="1dp"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Заголовок конкурса -->
        <TextView
            android:id="@+id/contestTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Обними, если сможешь!"
            android:textColor="#2E7D32"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            android:lineSpacingExtra="4sp"/>

        <!-- Локация -->
        <TextView
            android:id="@+id/location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Д.Болгуры [Бабушкины Ивы]"
            android:textColor="#5D4037"
            android:textSize="14sp"
            android:drawableStart="@drawable/map_icon"
            android:drawablePadding="6dp"
            android:drawableTint="#5D4037"/>

        <!-- Разделитель -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="#EEEEEE"/>

        <!-- Описание -->
        <TextView
            android:id="@+id/description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Обнимите дерево полностью (можно не в одиночку), а затем сфотографируйтесь"
            android:textColor="#424242"
            android:textSize="14sp"
            android:lineSpacingExtra="6sp"/>

        <!-- Кнопка -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/actionButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="16dp"
            android:backgroundTint="#2E7D32"
            android:text="Отправить работу"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            app:cornerRadius="8dp"
            app:icon="@drawable/white_right_arrow"
            app:strokeColor="#1B5E20"
            app:strokeWidth="1dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>